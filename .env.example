# Copie este arquivo para ".env" e preencha com suas chaves reais.
# NUNCA suba o arquivo ".env" (com as chaves de verdade) para o GitHub.

# Chave da API do Gemini (console: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=cole_sua_chave_do_gemini_aqui

# Chave da RapidAPI (Free API Live Football Data)
RAPIDAPI_KEY=cole_sua_chave_do_rapidapi_aqui

# Porta local do servidor (pode deixar como está)
PORT=3000
